# ==============================================================================
# HeatWatch Environment Configuration
# ==============================================================================

# 1. NASA FIRMS API MAP KEY (Required for live NASA satellite data)
# Obtain free from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=d52a4d6f13515fb7ed72aa01f8b7200b

# 2. OpenStreetMap Overpass API (Free public instance, no key needed)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# 3. Copernicus Sentinel Hub / Planet Public Data Configuration
# User Configuration ID (covers Sentinel-2 L2A Optical/SWIR and Sentinel-1 SAR)
SENTINEL_HUB_INSTANCE_ID=60de79ca-16a7-4afd-bcbd-0261bf0156fa
EARTH_ENGINE_PROJECT_ID=firedetection-506905

# 4. Local Web Server Port
PORT=3000
